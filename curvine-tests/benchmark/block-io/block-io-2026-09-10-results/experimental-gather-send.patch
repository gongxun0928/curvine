+use std::io::{self, IoSlice};
+use tokio::io::{AsyncWrite, AsyncWriteExt};
+
+/// Send the in-memory parts of one frame together without copying its payload.
+/// A successful vectored write may consume only part of any slice, especially
+/// with a full socket send buffer. Keep advancing until every byte is written.
+pub(super) async fn write_buffers<W: AsyncWrite + Unpin>(
+    writer: &mut W,
+    protocol: &[u8],
+    header: &[u8],
+    data: &[u8],
+) -> io::Result<()> {
+    let mut buffers = [
+        IoSlice::new(protocol),
+        IoSlice::new(header),
+        IoSlice::new(data),
+    ];
+    let mut remaining = &mut buffers[..];
+    while let Some(first) = remaining.iter().position(|buf| !buf.is_empty()) {
+        // Also supports AsyncWrite implementations that fall back to writing
+        // only the first slice, including when the optional header is empty.
+        remaining = &mut remaining[first..];
+        match writer.write_vectored(remaining).await {
+            Ok(0) => return Err(io::ErrorKind::WriteZero.into()),
+            Ok(written) => IoSlice::advance_slices(&mut remaining, written),
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::pin::Pin;
+    use std::task::{Context, Poll};
+
+    struct ShortWriter {
+        bytes: Vec<u8>,
+        limit: usize,
+        pending: bool,
+        interrupt: bool,
+        fail: Option<io::ErrorKind>,
+        vectored: bool,
+    }
+
+    impl AsyncWrite for ShortWriter {
+        fn is_write_vectored(&self) -> bool {
+            self.vectored
+        }
+
+        fn poll_write_vectored(
+            self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            buffers: &[IoSlice<'_>],
+        ) -> Poll<io::Result<usize>> {
+            if self.vectored {
+                let bytes = buffers
+                    .iter()
+                    .flat_map(|buf| buf.iter().copied())
+                    .collect::<Vec<_>>();
+                self.poll_write(cx, &bytes)
+            } else {
+                self.poll_write(cx, buffers.first().map_or(&[], |buf| &buf[..]))
+            }
+        }
+        fn poll_write(
+            mut self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            buf: &[u8],
+        ) -> Poll<io::Result<usize>> {
+            if self.interrupt {
+                self.interrupt = false;
+                return Poll::Ready(Err(io::ErrorKind::Interrupted.into()));
+            }
+            if let Some(error) = self.fail {
+                return Poll::Ready(Err(error.into()));
+            }
+            if self.pending {
+                self.pending = false;
+                cx.waker().wake_by_ref();
+                return Poll::Pending;
+            }
+            self.pending = true;
+            let len = buf.len().min(self.limit);
+            self.bytes.extend_from_slice(&buf[..len]);
+            Poll::Ready(Ok(len))
+        }
+
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+        fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    fn writer(limit: usize) -> ShortWriter {
+        ShortWriter {
+            bytes: Vec::new(),
+            limit,
+            pending: true,
+            interrupt: true,
+            fail: None,
+            vectored: false,
+        }
+    }
+
+    #[tokio::test]
+    async fn partial_writes_pending_interrupts_and_empty_slices() {
+        for limit in [1, 2, 7, 1024] {
+            for (protocol, header, data) in [
+                (&b"protocol"[..], &b"header"[..], &b"payload"[..]),
+                (&b"protocol"[..], &b""[..], &b"payload"[..]),
+                (&b""[..], &b"header"[..], &b""[..]),
+                (&b""[..], &b""[..], &b""[..]),
+            ] {
+                for vectored in [false, true] {
+                    let mut writer = writer(limit);
+                    writer.vectored = vectored;
+                    write_buffers(&mut writer, protocol, header, data)
+                        .await
+                        .unwrap();
+                    assert_eq!(writer.bytes, [protocol, header, data].concat());
+                }
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn zero_write_and_peer_error_are_returned() {
+        let mut zero = writer(0);
+        assert_eq!(
+            write_buffers(&mut zero, b"p", b"h", b"d")
+                .await
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::WriteZero
+        );
+        let mut broken = writer(1);
+        broken.fail = Some(io::ErrorKind::BrokenPipe);
+        assert_eq!(
+            write_buffers(&mut broken, b"p", b"h", b"d")
+                .await
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::BrokenPipe
+        );
+    }
+}
